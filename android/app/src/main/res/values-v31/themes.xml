<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Real" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#78A9FF</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Splash: the white "Real" on black; StartupIntroOverlay picks it up in the same spot and slides it home. -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_wordmark</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
